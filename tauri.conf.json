{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Autark",
  "version": "2026.11.0",
  "identifier": "dev.verzly.autark",
  "build": {
    "frontendDist": "ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": { "cwd": "ui", "script": "pnpm dev --port 5173 --strictPort" },
    "beforeBuildCommand": { "cwd": "ui", "script": "pnpm build" }
  },
  "app": {
    "windows": [
      {
        "title": "Autark",
        "width": 1180,
        "height": 780,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": false,
    "icon": ["assets/icon.ico"]
  }
}
